// The report is published to GitHub Pages only by Kseniia's Jenkins.

pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    environment {
        DOCKERHUB_REPO = 'ksenishl/alexandria'
        DOCKER_IMAGE_TAG = '1.0.0'
        DOCKER_IMAGE_LATEST_TAG = 'latest'
        DOCKERHUB_CREDENTIALS_ID = 'dockerhub-credentials'
    }

    stages {
        stage('Code Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/veiston/Alexandria-The-Text-Analysis-Tool.git'
            }
        }

        stage('Build') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn clean package -DskipTests'
                    } else {
                        bat 'mvn clean package -DskipTests'
                    }
                }
            }
        }

        stage('Unit Tests') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn test'
                    } else {
                        bat 'mvn test'
                    }
                }
            }
        }

        stage('Generate JaCoCo Report') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn verify'
                    } else {
                        bat 'mvn verify'
                    }
                }
            }
        }

        stage('Publish Test Results') {
            steps {
                junit 'target/surefire-reports/*.xml'
            }
        }

        stage('Publish JaCoCo Report') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'target/site/jacoco',
                    reportFiles: 'index.html',
                    reportName: 'JaCoCo Coverage Report'
                ])
            }
        }

        stage('Publish JaCoCo Report to GitHub Pages') {
            when {
                environment name: 'PUBLISH_GITHUB_PAGES', value: 'true'
            }

            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'alexandria-jacoco-reports-credentials',
                    usernameVariable: 'GITHUB_USERNAME',
                    passwordVariable: 'GITHUB_TOKEN'
                )]) {
                    sh '''
                        rm -rf jacoco-pages
                        mkdir jacoco-pages
                        cp -R target/site/jacoco/. jacoco-pages/
                        cd jacoco-pages
                        git init
                        git checkout -b gh-pages
                        git config user.name "Jenkins"
                        git config user.email "kseniia.shlenskaia@gmail.com"
                        git add .
                        git commit -m "Publish JaCoCo report build ${BUILD_NUMBER}"
                        git remote add origin "https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/x-bananer/alexandria-jacoco-reports.git"
                        git push --force origin gh-pages
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build(
                        "${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG}",
                        '--platform linux/amd64 -f docker/Dockerfile .'
                    )
                    sh "docker tag ${DOCKERHUB_REPO}:${DOCKER_IMAGE_TAG} ${DOCKERHUB_REPO}:${DOCKER_IMAGE_LATEST_TAG}"
                }
            }
        }

        stage('Test Docker Image') {
            steps {
                sh 'docker run --rm --platform linux/amd64 --entrypoint java "$DOCKERHUB_REPO:$DOCKER_IMAGE_TAG" --version'
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: DOCKERHUB_CREDENTIALS_ID,
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKERHUB_PASSWORD" | docker login \\
                            -u "$DOCKERHUB_USERNAME" \\
                            --password-stdin
                        docker push "$DOCKERHUB_REPO:$DOCKER_IMAGE_TAG"
                        docker push "$DOCKERHUB_REPO:$DOCKER_IMAGE_LATEST_TAG"
                    '''
                }
            }
        }

        stage('Run Docker Compose') {
            steps {
                withEnv(['HOST_FILES_DIR=/tmp']) {
                    sh 'docker compose -f docker/docker-compose.yml up -d'
                }
            }
        }
    }
}
